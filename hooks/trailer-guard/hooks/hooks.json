{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/trailer_guard.py",
            "timeout": 15,
            "statusMessage": "trailer-guard: checking trailers before publishing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/trailer_guard.py",
            "timeout": 15,
            "statusMessage": "trailer-guard: checking commit trailers"
          }
        ]
      }
    ]
  }
}
